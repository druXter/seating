// prisma/schema.prisma
// Kein eigener migrations-Ordner - wie im Abstimmungstool und in rsvp-app ausschließlich per
// `npx prisma db push` synchronisiert (siehe README.md/Dockerfile).
//
// Konten-Tabellen 1:1 nach dem Abstimmungstool (Phase 0), Raumplan-Vorlagen (Phase 1), Events mit
// Einheiten und Freigaben sowie der Kern von Buchung/Belegung (Phase 2), Verifizierung, Verwaltungslink
// und Protokolle (Phase 3), Buchungsverwaltung und Rundmail (Phase 4), siehe docs/KONZEPT.md
// Abschnitt 3. Felder kommen mit der Phase, die sie nutzt - mit `db push` kostet das Nachziehen nichts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Gleiche Rollen wie im Abstimmungstool und in rsvp-app, aber eigenständig vergeben:
// ADMIN sieht/verwaltet alle Events, Raumpläne und Konten. CREATOR legt eigene Events und
// Raumpläne an und teilt sie mit anderen Konten. MODERATOR legt nichts selbst an, sondern
// bearbeitet ausschließlich ihm freigegebene Events (z.B. das Brautpaar für die eigene
// Hochzeit). Die Freigabe pro Event steht in EventAccess (analog PollAccess).
enum Role {
  ADMIN
  CREATOR
  MODERATOR
}

// Ein lokales Konto dieses Tools - nur für Veranstalter*innen. Buchende haben kein Konto.
// Registrierung ist nicht öffentlich: Konten legt ein eingeloggtes Konto an (Einladungslink,
// siehe resetTokenHash) oder sie entstehen später beim ersten Login über ein verbundenes Tool
// (ExternalIdentity, Phase 8). passwordHash ist null bei rein föderierten Konten und bei noch
// nicht angenommenen Einladungen - beides kann sich nur nicht per Passwort anmelden.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(CREATOR)
  createdAt    DateTime @default(now())
  // Zuletzt bei einer Anmeldung gesetzt (siehe issueSession in app/lib/auth.ts). Grundlage
  // für die automatische Löschung inaktiver Konten (app/api/cron/cleanup/route.ts) -
  // Admin-Konten sind davon ausgenommen.
  lastLoginAt  DateTime @default(now())

  // Einladung UND Passwort-Reset teilen sich denselben Mechanismus: ein einmaliger,
  // befristeter Link. Gespeichert wird nur der SHA-256-Hash des Tokens, damit ein
  // Datenbank-Leak keine gültigen Links preisgibt (siehe app/lib/auth.ts hashToken).
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  sessions     Session[]
  identities   ExternalIdentity[]
  floorPlans   FloorPlan[]
  events       Event[]
  eventAccess  EventAccess[]
  broadcasts   Broadcast[]
}

// Server-seitige Session: das Cookie trägt nur den zufälligen Token, in der Datenbank
// liegt ausschließlich dessen SHA-256-Hash - ein Leak der Datenbank ergibt also keine
// übernehmbaren Sitzungen.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Verknüpfung eines lokalen Kontos mit einem Konto in einem anderen Tool der Suite
// (siehe suite-kit, genutzt ab Phase 8). Identität ist (issuer, subject) - NIE die E-Mail,
// die sich beim Anbieter ändern lässt. issuer = Origin des Anbieter-Tools, subject = dessen Konto-ID.
model ExternalIdentity {
  id        String   @id @default(cuid())
  issuer    String
  subject   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issuer, subject])
  @@index([userId])
}

// Zähler gegen Passwort-Raten und Mail-Flut (siehe app/lib/throttle.ts). `key` ist ein
// SHA-256-Hash aus Bereich + Kennung (E-Mail bzw. IP-Adresse) - es werden also weder
// Adressen noch IPs im Klartext gespeichert. Zeilen werden nach Ablauf des Zeitfensters
// bei Gelegenheit wieder gelöscht. Die Buchungs-Drosselung nutzt eine eigene Tabelle
// BookingThrottle nach demselben Muster.
model LoginThrottle {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Wie LoginThrottle, aber für öffentliche Buchungsformulare (reservieren, Code eingeben, Mail
// erneut senden) - getrennt, damit Buchende nie die Anmeldung von Konten stören und umgekehrt.
model BookingThrottle {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Wiederverwendbarer Raumplan ("Festsaal", "Hörsaal M001"). Beim Anlegen eines Events wird der
// Plan kopiert (Event.layout) - spätere Änderungen hier verändern keine laufenden Events.
//
// layout: das geprüfte JSON-Format aus app/lib/floorplan/schema.ts (vor JEDEM Schreiben mit
// parseLayout geprüft). version: steigt bei jedem Speichern; der Editor schickt die Version mit,
// auf der er aufbaut - passt sie nicht mehr (zweiter Tab, anderes Konto), wird nicht still
// überschrieben, sondern ein Konflikt gemeldet.
//
// shared: als gemeinsame Vorlage angeboten - andere Creator dürfen den Plan ansehen und
// duplizieren, aber nicht ändern (siehe app/lib/permissions.ts). ownerId ist nur null, wenn das
// Konto trotz Umhängen beim Löschen verschwunden ist (SetNull als Sicherheitsnetz) - dann nur Admins.
//
// backgroundFile: zufälliger Dateiname in UPLOAD_DIR (nie ein Pfad), backgroundType der beim
// Upload am Dateiinhalt erkannte MIME-Typ. Die Lage des Bilds steht in layout.background.
model FloorPlan {
  id             String   @id @default(cuid())
  name           String
  ownerId        String?
  owner          User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  shared         Boolean  @default(false)
  layout         Json
  version        Int      @default(1)
  backgroundFile String?
  backgroundType String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  events         Event[]

  @@index([ownerId])
}

// Wer bucht was (docs/KONZEPT.md Abschnitt 1). Phase 2 bietet in der Oberfläche nur TABLE + OPEN an;
// die übrigen Werte stehen schon hier, damit spätere Phasen das Schema nicht umbauen müssen.
enum EventMode {
  TABLE
  SEAT
  ASSIGNED
}

enum BookingAccess {
  OPEN
  RSVP
  NONE
}

// DRAFT und ARCHIVED sind öffentlich nicht sichtbar (404), OPEN und CLOSED schon - CLOSED nur
// ohne Buchungsmöglichkeit.
enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

// Eine Veranstaltung unter /<slug>. layout ist eine KOPIE der Vorlage (sourcePlanId nur zur
// Information, "aus Vorlage X") - geprüft wie FloorPlan.layout, mit layoutVersion als
// Konfliktschutz beim Speichern. Aus layout abgeleitet steht jede buchbare Einheit zusätzlich in
// Unit (abgeglichen bei jedem Speichern, siehe app/lib/events/save-layout.ts).
//
// Zeiten in UTC; timezone bestimmt Eingabe und Anzeige (vorerst immer Europe/Berlin).
// minFillRatio: Mindestbelegung eines Tisches (0.5 = 8er-Tisch ab 4 Personen), null = keine.
// pendingTtlMinutes: so lange hält eine unbestätigte Buchung ihren Tisch.
// selfEditHoursBefore: Buchende ändern/stornieren selbst bis startsAt minus so viele Stunden (0 = bis
// Beginn) - als Abstand gespeichert, damit die Frist mitwandert, wenn das Event verschoben wird.
// replyTo/mailNote: Antwortadresse und freier Hinweis in den Buchungsmails.
// waitlistEnabled/offerTtlHours: Warteliste mit Nachrück-Angebot, das so viele Stunden gilt
// (docs/KONZEPT.md Abschnitt 5, app/lib/events/waitlist.ts).
// ownerId: wie bei FloorPlan, SetNull nur als Sicherheitsnetz (beim Löschen eines Kontos werden
// Events umgehängt).
model Event {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String        @default("")
  location        String        @default("")
  startsAt        DateTime
  endsAt          DateTime
  timezone        String        @default("Europe/Berlin")
  mode            EventMode     @default(TABLE)
  access          BookingAccess @default(OPEN)
  status          EventStatus   @default(DRAFT)
  bookingOpensAt  DateTime?
  bookingClosesAt DateTime?
  minFillRatio    Float?
  pendingTtlMinutes   Int     @default(30)
  selfEditHoursBefore Int     @default(24)
  oneBookingPerEmail  Boolean @default(true)
  requirePhone        Boolean @default(false)
  replyTo             String?
  mailNote            String  @default("")
  waitlistEnabled     Boolean @default(true)
  offerTtlHours       Int     @default(24)
  layout          Json
  layoutVersion   Int           @default(1)
  backgroundFile  String?
  backgroundType  String?
  ownerId         String?
  owner           User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sourcePlanId    String?
  sourcePlan      FloorPlan?    @relation(fields: [sourcePlanId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  units       Unit[]
  bookings    Booking[]
  allocations Allocation[]
  shares      EventAccess[]
  mailLogs    MailLog[]
  auditLogs   AuditLog[]
  broadcasts  Broadcast[]

  @@index([ownerId])
  @@index([endsAt])
}

// Freigabe eines Events an ein weiteres Konto (analog PollAccess im Abstimmungstool): darf alles
// außer löschen und weiter freigeben (siehe eventLevel in app/lib/permissions.ts).
model EventAccess {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

enum UnitKind {
  TABLE
  SEAT
}

// Buchbare Einheit eines Events, abgeleitet aus Event.layout (app/lib/floorplan/units.ts). key ist
// stabil und wird nie neu vergeben; Buchungen referenzieren die Einheit, nie das Label.
// tableKey: Platz gehört zu diesem Tisch (gemischte Belegung verhindern).
model Unit {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key         String
  kind        UnitKind
  label       String
  tableKey    String?
  capacity    Int
  bookable    Boolean
  allocations Allocation[]

  @@unique([eventId, key])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  WAITLISTED
  OFFERED
}

enum BookingSource {
  PUBLIC
  RSVP
  ADMIN
}

// Eine Buchung (docs/KONZEPT.md Abschnitte 3-6). expiresAt nur bei PENDING/OFFERED: Danach gilt die
// Buchung schon beim Lesen als verfallen.
//
// Verifizierung: verifyTokenHash = SHA-256 des Links (32 Byte Zufall), verifyCodeHmac =
// HMAC(VERIFY_CODE_SECRET, id:code) - nie der reine Hash eines 6-stelligen Codes. Beides wird bei der
// Bestätigung gelöscht. pendingIpHash (SHA-256 der IP) nur solange unbestätigt, für die Obergrenze
// gleichzeitiger Reservierungen pro IP.
//
// Verwaltungslink: nicht gespeichert, sondern HMAC(MANAGE_LINK_SECRET, id:manageTokenVersion) -
// "Link neu erzeugen" erhöht die Version (app/lib/booking-tokens.ts).
//
// Warteliste: WAITLISTED ohne Allocation. Bis zur Bestätigung der Adresse (emailVerifiedAt leer) zählt
// der Eintrag nicht und verfällt mit expiresAt; waitlistedAt (Zeitpunkt der Bestätigung) bestimmt die
// Reihenfolge. OFFERED: Angebot mit Allocation bis expiresAt.
//
// email: nur bei source = ADMIN leer (telefonische Reservierung ohne Adresse) - solche Buchungen sind
// direkt bestätigt und bekommen keine Mails. adminNote: interne Notiz der Veranstalter*innen, nie in
// Mails, auf der Verwaltungsseite oder öffentlich sichtbar.
model Booking {
  id          String        @id @default(cuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status      BookingStatus
  source      BookingSource
  name        String
  email       String?
  partySize   Int
  phone       String?
  note        String?
  adminNote   String?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cancelledAt DateTime?

  emailVerifiedAt    DateTime?
  waitlistedAt       DateTime?
  verifyTokenHash    String?   @unique
  verifyCodeHmac     String?
  verifyAttempts     Int       @default(0)
  pendingIpHash      String?
  manageTokenVersion Int       @default(1)
  icsSequence        Int       @default(0)

  allocations Allocation[]
  mailLogs    MailLog[]
  auditLogs   AuditLog[]

  @@index([eventId, status])
  @@index([eventId, email])
  @@index([pendingIpHash])
}

// Belegung einer Einheit durch eine Buchung. DER Unique-Index (eventId, unitId) ist die Garantie
// gegen Doppelbuchung - nicht eine vorherige Abfrage (docs/KONZEPT.md Abschnitt 5). eventId steht
// redundant hier, damit der Index pro Event greift.
//
// unit: NoAction - eine belegte Einheit lässt sich auch auf Datenbankebene nicht löschen (SQLite
// prüft NO ACTION erst am Ende der Anweisung, das Löschen eines ganzen Events per Cascade geht
// also weiterhin). Verfallene Buchungen verlieren ihre Allocations (siehe app/lib/events/save-layout.ts).
model Allocation {
  id           String  @id @default(cuid())
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit    @relation(fields: [unitId], references: [id], onDelete: NoAction)
  bookingId    String
  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  attendeeName String?

  @@unique([eventId, unitId])
  @@index([bookingId])
  @@index([unitId])
}

// Jede verschickte (oder gescheiterte) Buchungsmail - für Rückfragen ("ich habe nichts bekommen").
// Verschwindet mit Buchung bzw. Event.
//
// status: sent | failed, bei Rundmails zusätzlich die Warteschlange queued -> sending -> sent |
// failed | skipped (Buchung inzwischen nicht mehr aktiv). claimedAt: seit wann ein Worker die Zeile
// verschickt - bleibt eine Zeile in "sending" hängen (Neustart mitten im Versand), setzt der Cron sie
// auf failed statt sie noch einmal zu schicken (siehe app/lib/events/broadcast.ts).
model MailLog {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  broadcastId String?
  broadcast   Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  type        String
  recipient   String
  status      String
  error       String?
  claimedAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([eventId])
  @@index([bookingId])
  @@index([broadcastId])
  @@index([status])
}

// Rundmail an die Buchenden eines Events (Konzept Abschnitt 7): Einzelmails mit dem jeweils eigenen
// Verwaltungslink, verschickt über eine einfache Warteschlange (die Empfänger stehen als MailLog-Zeilen
// mit status "queued"). Der Text wird erst beim Versand mit den aktuellen Buchungsdaten kombiniert.
model Broadcast {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  includeIcs  Boolean   @default(false)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  mails       MailLog[]

  @@index([eventId])
}

// Wer hat wann was an einer Buchung geändert (Konzept Abschnitt 8). actor: Konto-id, "customer"
// oder "system". diff: JSON mit alten/neuen Werten (Tische als stabiler key). bookingId null: Eintrag
// zum Event selbst (endgültig gelöschte Buchung - dann ohne Personendaten -, Rundmail).
// Angezeigt im Admin-Bereich (app/lib/events/audit-text.ts).
model AuditLog {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  diff      Json
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([bookingId])
}
