DATABASE_URL="file:./dev.db"

# Basis-URL für generierte Links (Einladung, Passwort-Reset, später Verwaltungslinks und
# .ics). In Produktion die echte, öffentlich erreichbare Domain eintragen (ohne
# abschließenden Slash). Sie ist zugleich die Kennung dieses Tools gegenüber anderen Tools
# der Suite (SUITE_*, unten) - muss also exakt der Adresse entsprechen, unter der die anderen
# Tools es erreichen.
BASE_URL=http://localhost:3700

# Wie viele Reverse Proxys vor diesem Tool stehen. Bestimmt, welcher Eintrag von
# X-Forwarded-For als Besucher-IP für die Drosselung gilt (von rechts gezählt - links steht
# Beliebiges, das der Client selbst mitschicken kann). 1 = ein Proxy. 0 = direkter Zugriff
# ohne Proxy (der Header wird dann komplett ignoriert und alle Besucher teilen sich EINEN
# Zähler - nur für lokale Entwicklung sinnvoll).
# Nicht raten, sondern messen: Hinter dem Cloudflare Tunnel (cloudflared, ohne weiteren Proxy)
# steht die echte Besucher-IP als LETZTER Eintrag, also 1 - für Seating gemessen am 27.09.2026.
# Prüfen: einen Fehlversuch beim Login machen und schauen, ob in LoginThrottle eine Zeile
# mit dem Schlüssel SHA-256("login:ip" + Null-Byte + <eigene IP>) existiert.
TRUST_PROXY_HOPS=1

# Impressum-Angaben (siehe app/impressum/page.tsx) - gleiche Namen wie in den anderen
# Tools der Suite. Ohne diese Werte zeigt die Seite Platzhalter.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_ZIP=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=
IMPRESSUM_PHONE=

# Für den Aufräum-Cronjob (app/api/cron/cleanup), von einem externen Scheduler (z.B.
# Uptime Kuma) täglich mit ?secret=... aufgerufen. Leer = Endpunkt lehnt alles ab.
# Generieren z.B. mit: openssl rand -hex 24
CRON_SECRET=

# SMTP-Zugangsdaten (siehe app/lib/mail.ts) für Einladungs-, Passwort-Reset- und Buchungsmails.
# Ohne SMTP_HOST wird der Einladungslink dem einladenden Konto auf dem Bildschirm angezeigt,
# Passwort-Reset per Mail ist dann nicht möglich - und die Online-Buchung ist abgeschaltet
# (Buchungen brauchen die Bestätigung per Mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Seating <deine-email@domain.de>"
# Rundmails gehen einzeln und gedrosselt raus (app/lib/events/broadcast.ts), damit der Mailserver
# nicht sperrt. Mails pro Minute, Standard 30 (1-600) - an die Grenzen des Postfachs anpassen.
# BROADCAST_MAILS_PER_MINUTE=30

# Hintergrund-Durchlauf im Serverprozess (app/lib/events/sweep.ts): setzt abgelaufene Reservierungen und
# Angebote auf "verfallen" und bietet frei gewordene Tische der Warteliste an. Sekunden, Standard 60,
# 0 = aus (dann nur über den Cron - ein frei gewordener Tisch würde bis zum nächsten Cron niemandem
# angeboten).
# SWEEP_INTERVAL_SECONDS=60

# Geheimnisse für Buchungen (siehe app/lib/booking-tokens.ts), je mindestens 32 Zeichen. Fehlt eins,
# ist die Online-Buchung abgeschaltet. Generieren z.B. mit: openssl rand -base64 48
#
# VERIFY_CODE_SECRET: 6-stellige Bestätigungscodes werden nur als HMAC damit gespeichert. Wechseln ist
#   unkritisch (entwertet nur gerade offene Codes, der Link in der Mail funktioniert weiter).
# MANAGE_LINK_SECRET: daraus werden die persönlichen Verwaltungslinks abgeleitet. Wechseln entwertet
#   alle verschickten Links - deshalb beim Wechsel das alte als MANAGE_LINK_SECRET_PREVIOUS eintragen,
#   dann gelten alte und neue Links.
VERIFY_CODE_SECRET=
MANAGE_LINK_SECRET=
MANAGE_LINK_SECRET_PREVIOUS=

# Anbindung an rsvp-app (optional, siehe README "Anbindung an rsvp-app"). Ohne beide Werte ist sie aus.
# RSVP_SEATING_SECRET: gemeinsames HMAC-Secret, in rsvp-app identisch als SEATING_SECRET eintragen,
#   mindestens 32 Zeichen (openssl rand -hex 32). Nie das Secret des Abstimmungstools wiederverwenden.
# RSVP_APP_BASE_URL: öffentliche Adresse von rsvp-app (Ziel der Anfragen, Empfänger der Nachrichten).
RSVP_SEATING_SECRET=
RSVP_APP_BASE_URL=

# --- Konto-Föderation der App-Suite (optional, siehe README "Anmelden mit einem Konto aus einem
# anderen Tool" und README von suite-kit). Ohne diese Werte arbeitet Seating nur mit eigenen
# Konten - es gibt dann nicht einmal einen Login-Button für andere Tools.

# Anzeigename dieses Tools auf den Login-Buttons anderer Tools (Standard: Seating).
SUITE_APP_NAME="Seating"

# ANBIETER-Seite: Privater Signierschlüssel dieses Tools. Erzeugen mit:
#   node node_modules/suite-kit/bin/suite-keygen.js
# Geheim halten - er verlässt dieses Tool nie, jedes Tool hat seinen eigenen. Der öffentliche
# Teil wird automatisch unter /.well-known/suite-identity veröffentlicht. Leer = Seating stellt
# keine Logins für andere Tools aus.
SUITE_SIGNING_KEY=
# Nur während einer Schlüsselrotation: der bisherige Schlüssel, damit noch gültige
# Bestätigungen weiter prüfbar bleiben (2 Minuten reichen).
SUITE_SIGNING_KEY_PREVIOUS=

# ANBIETER-Seite: Kommagetrennte Origins der Tools, die Logins von hier empfangen dürfen,
# z.B. https://rsvp.deine-domain.de,https://vote.deine-domain.de
SUITE_TRUSTED_APPS=

# EMPFÄNGER-Seite: Tools, mit deren Konten man sich hier anmelden darf. Entweder Origins
# kommagetrennt (https://rsvp.deine-domain.de) oder JSON für Einzeleinstellungen:
#   [{"issuer":"https://rsvp.deine-domain.de","label":"rsvp-app","autoProvision":false}]
# autoProvision: erster Login legt automatisch ein Konto ohne Passwort an (Standard: true).
#                Für Seating empfohlen: false - Konten brauchen hier nur Veranstalter*innen;
#                wer eingeladen ist, verknüpft das andere Konto unter "Mein Konto".
# mapAdminRole:  Admins des anderen Tools werden hier ebenfalls Admin (Standard: false,
#                sonst Creator; Moderator*innen bleiben Moderator*innen).
SUITE_IDPS=

# Ablage hochgeladener Dateien (Hintergrundbilder von Raumplänen). Optional - Standard ist
# data/uploads im Arbeitsverzeichnis, im Docker-Container also /app/data/uploads im Volume.
# UPLOAD_DIR=
