DATABASE_URL="file:./dev.db"

# Basis-URL für generierte Links (Einladung, Passwort-Reset, später Verwaltungslinks und
# .ics). In Produktion die echte, öffentlich erreichbare Domain eintragen (ohne
# abschließenden Slash). Sie ist zugleich die Kennung dieses Tools gegenüber anderen Tools
# der Suite (ab Phase 8) - muss also exakt der Adresse entsprechen, unter der die anderen
# Tools es erreichen.
BASE_URL=http://localhost:3700

# Wie viele Reverse Proxys vor diesem Tool stehen. Bestimmt, welcher Eintrag von
# X-Forwarded-For als Besucher-IP für die Drosselung gilt (von rechts gezählt - links steht
# Beliebiges, das der Client selbst mitschicken kann). 1 = ein Proxy. 0 = direkter Zugriff
# ohne Proxy (der Header wird dann komplett ignoriert und alle Besucher teilen sich EINEN
# Zähler - nur für lokale Entwicklung sinnvoll).
# Nicht raten, sondern messen: Hinter Cloudflare + Nginx Proxy Manager (mit dessen Real-IP-
# Erkennung) stand die echte Besucher-IP im Abstimmungstool als LETZTER Eintrag, also 1.
# Prüfen: einen Fehlversuch beim Login machen und schauen, ob in LoginThrottle eine Zeile
# mit dem Schlüssel SHA-256("login:ip" + Null-Byte + <eigene IP>) existiert.
TRUST_PROXY_HOPS=1

# Impressum-Angaben (siehe app/impressum/page.tsx) - gleiche Namen wie in den anderen
# Tools der Suite. Ohne diese Werte zeigt die Seite Platzhalter.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_ZIP=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=
IMPRESSUM_PHONE=

# Für den Aufräum-Cronjob (app/api/cron/cleanup), von einem externen Scheduler (z.B.
# Uptime Kuma) täglich mit ?secret=... aufgerufen. Leer = Endpunkt lehnt alles ab.
# Generieren z.B. mit: openssl rand -hex 24
CRON_SECRET=

# SMTP-Zugangsdaten (siehe app/lib/mail.ts) für Einladungs-, Passwort-Reset- und Buchungsmails.
# Ohne SMTP_HOST wird der Einladungslink dem einladenden Konto auf dem Bildschirm angezeigt,
# Passwort-Reset per Mail ist dann nicht möglich - und die Online-Buchung ist abgeschaltet
# (Buchungen brauchen die Bestätigung per Mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Seating <deine-email@domain.de>"

# Geheimnisse für Buchungen (siehe app/lib/booking-tokens.ts), je mindestens 32 Zeichen. Fehlt eins,
# ist die Online-Buchung abgeschaltet. Generieren z.B. mit: openssl rand -base64 48
#
# VERIFY_CODE_SECRET: 6-stellige Bestätigungscodes werden nur als HMAC damit gespeichert. Wechseln ist
#   unkritisch (entwertet nur gerade offene Codes, der Link in der Mail funktioniert weiter).
# MANAGE_LINK_SECRET: daraus werden die persönlichen Verwaltungslinks abgeleitet. Wechseln entwertet
#   alle verschickten Links - deshalb beim Wechsel das alte als MANAGE_LINK_SECRET_PREVIOUS eintragen,
#   dann gelten alte und neue Links.
VERIFY_CODE_SECRET=
MANAGE_LINK_SECRET=
MANAGE_LINK_SECRET_PREVIOUS=

# Ablage hochgeladener Dateien (Hintergrundbilder von Raumplänen). Optional - Standard ist
# data/uploads im Arbeitsverzeichnis, im Docker-Container also /app/data/uploads im Volume.
# UPLOAD_DIR=
